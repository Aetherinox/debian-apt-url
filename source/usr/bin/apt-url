#!/bin/bash

# #
#   @author 	    aetherinox
#   @script 		Proteus apt-url
#   @when   		2025-05-01 21:00:00
#   @url    	    https://github.com/Aetherinox/debian-apt-url
#	
#   requires chmod +x apt-url
#	requires apt-move to be installed
#		
#	
# #

FETCH=/usr/lib/apt-move/fetch

# #
#   define > app
# #

app_title="apt-url"
app_about="A package which allows you to fetch information about a package, including the url of where it is hosted"
app_ver=("1" "1" "0")
app_dir_this_file="$( cd "$( dirname "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )"    	# path where script was last found in
app_dir_this_dir="${PWD}"                                                            	# the path where script is called from
app_file_this=$(basename "$0")                                                          # apt-url.sh (with ext)
app_file_bin="${app_file_this%.*}"                                                      # apt-url (without ext)
app_pid=$BASHPID
app_build="2025-23-05"

# #
#   vars > app repo
# #

repo_name="apt-url"
repo_author="Aetherinox"
repo_branch="main"
repo_url="https://github.com/${repo_author}/${repo_name}"

# #
#	arguments
# #

argPackage=
argBoolFileOnly=false
argBoolUrlOnly=false
argBoolPretty=false

# #
#   define > colors
#
#   Use the color table at:
#       - https://gist.github.com/fnky/458719343aabd01cfb17a3a4f7296797
# #

declare -A c=(
    end $'\e[0m'
    white $'\e[97m'
    bold $'\e[1m'
    dim $'\e[2m'
    underline $'\e[4m'
    strike $'\e[9m'
    blink $'\e[5m'
    inverted $'\e[7m'
    hidden $'\e[8m'
    black $'\e[38;5;0m'
    fuchsia1 $'\e[38;5;205m'
    fuchsia2 $'\e[38;5;198m'
    red $'\e[38;5;160m'
    red2 $'\e[38;5;196m'
    orange $'\e[38;5;202m'
    orange2 $'\e[38;5;208m'
    magenta $'\e[38;5;5m'
    blue $'\e[38;5;033m'
    blue2 $'\e[38;5;033m'
    blue3 $'\e[38;5;68m'
    cyan $'\e[38;5;51m'
    green $'\e[38;5;2m'
    green2 $'\e[38;5;76m'
    yellow $'\e[38;5;184m'
    yellow2 $'\e[38;5;190m'
    yellow3 $'\e[38;5;193m'
    grey1 $'\e[38;5;240m'
    grey2 $'\e[38;5;244m'
    grey3 $'\e[38;5;250m'
    navy $'\e[38;5;62m'
    olive $'\e[38;5;144m'
    peach $'\e[38;5;210m'
)

# #
#   unicode for emojis
#       https://apps.timwhitlock.info/emoji/tables/unicode
# #

declare -A icon=(
    "symbolic link" $'\xF0\x9F\x94\x97' # 🔗
    "regular file" $'\xF0\x9F\x93\x84' # 📄
    "directory" $'\xF0\x9F\x93\x81' # 📁
    "regular empty file" $'\xe2\xad\x95' # ⭕
    "log" $'\xF0\x9F\x93\x9C' # 📜
    "1" $'\xF0\x9F\x93\x9C' # 📜
    "2" $'\xF0\x9F\x93\x9C' # 📜
    "3" $'\xF0\x9F\x93\x9C' # 📜
    "4" $'\xF0\x9F\x93\x9C' # 📜
    "5" $'\xF0\x9F\x93\x9C' # 📜
    "pem" $'\xF0\x9F\x94\x92' # 🔑
    "pub" $'\xF0\x9F\x94\x91' # 🔒
    "pfx" $'\xF0\x9F\x94\x92' # 🔑
    "p12" $'\xF0\x9F\x94\x92' # 🔑
    "key" $'\xF0\x9F\x94\x91' # 🔒
    "crt" $'\xF0\x9F\xAA\xAA ' # 🪪
    "gz" $'\xF0\x9F\x93\xA6' # 📦
    "zip" $'\xF0\x9F\x93\xA6' # 📦
    "gzip" $'\xF0\x9F\x93\xA6' # 📦
    "deb" $'\xF0\x9F\x93\xA6' # 📦
    "sh" $'\xF0\x9F\x97\x94' # 🗔
)

# #
#   define > system
# #

sys_arch=$(dpkg --print-architecture)
sys_code=$(lsb_release -cs)

# #
#   func > version > compare greater than
#
#   this function compares two versions and determines if an update may
#   be available. or the user is running a lesser version of a program.
# #

get_version_compare_gt()
{
    test "$(printf '%s\n' "$@" | sort -V | head -n 1)" != "$1";
}

# #
#   func > get version
#
#   returns current version of app
#   converts to human string.
#       e.g.    "1" "2" "4" "0"
#               1.2.4.0
# #

get_version()
{
    ver_join=${app_ver[@]}
    ver_str=${ver_join// /.}
    echo ${ver_str}
}

# #
#   Check Sudo
#
#	this script requires permissions to copy, etc.
# 	require the user to run as sudo
# #

check_sudo()
{
	if [ "$EUID" -ne 0 ]; then
        echo
        echo -e "  ${ORANGE}WARNING      ${WHITE}Must run script with ${YELLOW2}sudo${END}"
        echo -e "                    ${GREY2}sudo ./${app_file_this}${END}"

        exit 1
	fi
}

# #
#	func > opt_usage
# #

function opt_usage
{

    local func_parent=${app_file_bin}

    echo -e 
    printf "  ${c[blue]}${app_title}${c[end]}\n" 1>&2
    printf "  ${c[grey2]}${app_about}${c[end]}\n" 1>&2
    printf "  ${c[grey1]}last update:${c[end]} ${c[grey1]}$app_build${c[end]}\n" 1>&2
    printf "  ${c[fuchsia2]}$func_parent${c[end]} ${c[grey2]}--package ${c[yellow]}package-name${c[end]} \n" 1>&2
    echo -e 
    echo -e 
    printf '  %-5s %-40s\n' "${c[grey1]}Syntax:${c[end]}" "" 1>&2
    printf '  %-5s %-48s %-40s\n' "    " "${c[grey1]}Command${c[end]}           " "${c[fuchsia2]}$func_parent${c[end]} [ ${c[grey2]}-option${c[end]} [ ${c[yellow]}arg${c[end]} ]${c[end]} ]" 1>&2
    printf '  %-5s %-48s %-40s\n' "    " "${c[grey1]}Options${c[end]}           " "${c[fuchsia2]}$func_parent${c[end]} [ ${c[grey2]}-h${c[end]} | ${c[grey2]}--help${c[end]} ]" 1>&2
    printf '  %-5s %-48s %-40s\n' "    " "    ${c[grey2]}-A${c[end]}            " "required" 1>&2
    printf '  %-5s %-48s %-40s\n' "    " "    ${c[grey2]}-A...${c[end]}         " "required; multiple can be specified" 1>&2
    printf '  %-5s %-48s %-40s\n' "    " "    ${c[grey2]}[ -A ]${c[end]}        " "optional" 1>&2
    printf '  %-5s %-48s %-40s\n' "    " "    ${c[grey2]}[ -A... ]${c[end]}     " "optional; multiple can be specified" 1>&2
    printf '  %-5s %-48s %-40s\n' "    " "    ${c[grey2]}{ -A | -B }${c[end]}   " "one or the other; do not use both" 1>&2
    printf '  %-5s %-48s %-40s\n' "    " "${c[grey1]}Arguments${c[end]}         " "${c[fuchsia2]}$func_parent${c[end]} [ ${c[grey2]}-p${c[yellow]} package-name${c[end]} | ${c[grey2]}--package ${c[yellow]}package-name${c[end]} ] ${c[yellow]}arg${c[end]}" 1>&2
    printf '  %-5s %-48s %-40s\n' "    " "${c[grey1]}Examples${c[end]}          " "${c[fuchsia2]}${func_parent}${c[end]} ${c[yellow]}package-name${c[end]}" 1>&2
    printf '  %-5s %-48s %-40s\n' "    " "${c[grey1]}${c[end]}                  " "${c[fuchsia2]}${func_parent}${c[end]} ${c[grey2]}--package ${c[yellow]}package-name${c[end]}" 1>&2
    printf '  %-5s %-48s %-40s\n' "    " "${c[grey1]}${c[end]}                  " "${c[fuchsia2]}${func_parent}${c[end]} ${c[grey2]}--aptOnly --pretty --package ${c[yellow]}package-name${c[end]}" 1>&2
    echo -e
    printf '  %-5s %-40s\n' "${c[grey1]}Options:${c[end]}" "" 1>&2

    printf '  %-5s %-81s %-40s\n' "    " "${c[blue2]}-p${c[grey1]},${c[blue2]}  --package ${c[yellow]}<string>${c[end]}        " "package name to search for${c[end]}" 1>&2
    printf '  %-5s %-81s %-40s\n' "    " "${c[blue2]}-a${c[grey1]},${c[blue2]}  --aptOnly ${c[yellow]}${c[end]}                " "use apt-get to search for packages instead of apt-fetch${c[end]}" 1>&2
    printf '  %-5s %-81s %-40s\n' "    " "${c[blue2]}-f${c[grey1]},${c[blue2]}  --fileOnly ${c[yellow]}${c[end]}               " "only return url for package${c[end]}" 1>&2
    printf '  %-5s %-81s %-40s\n' "    " "${c[blue2]}-u${c[grey1]},${c[blue2]}  --urlOnly ${c[yellow]}${c[end]}                " "only return filename for package${c[end]}" 1>&2
    printf '  %-5s %-81s %-40s\n' "    " "${c[blue2]}-P${c[grey1]},${c[blue2]}  --pretty ${c[yellow]}${c[end]}                 " "show results in formatted layout${c[end]}" 1>&2
    printf '  %-5s %-81s %-40s\n' "    " "${c[blue2]}-s${c[grey1]},${c[blue2]}  --status ${c[yellow]}${c[end]}                 " "view list of assigned variables${c[end]}" 1>&2
    printf '  %-5s %-81s %-40s\n' "    " "${c[blue2]}-v${c[grey1]},${c[blue2]}  --version ${c[yellow]}${c[end]}                " "current version of this app${c[end]}" 1>&2
    printf '  %-5s %-81s %-40s\n' "    " "${c[blue2]}-x${c[grey1]},${c[blue2]}  --dev ${c[yellow]}${c[end]}                    " "developer mode; verbose logging${c[end]}" 1>&2
    printf '  %-5s %-81s %-40s\n' "    " "${c[blue2]}-h${c[grey1]},${c[blue2]}  --help ${c[yellow]}${c[end]}                   " "show this help menu${c[end]}" 1>&2
    echo -e 
    echo -e 
}

# #
#   options
# #

while [ $# -gt 0 ]; do
    case "$1" in
        -v|--ver|--version)
            echo -e 
            printf "  ${c[blue]}${app_title} - v$(get_version)${c[end]}\n" 1>&2
            printf "  ${c[grey2]}${app_about}${c[end]}\n" 1>&2
            printf "  ${c[grey1]}last update:${c[end]} ${c[grey1]}$app_build${c[end]}\n" 1>&2
            echo -e 
            echo -e 
            exit 1
            ;;
        -p|--pkg|--package)
            if [[ "$1" != *=* ]]; then shift; fi
            argPackage="${1#*=}"
            ;;
        -a|--aptOnly|--aptonly|--apt)
            argBoolUseApt=true
            ;;
        -P|--pretty|--prettify)
            argBoolPretty=true
            ;;
        -f|--fileOnly|--fileonly|--onlyfile)
            argBoolFileOnly=true
            ;;
        -u|--urlOnly|--urlomly|--onlyurl)
            argBoolUrlOnly=true
            ;;
        -h|--help)
            opt_usage $FUNCNAME
            exit 1
            ;;
        *)
            argPackage="${1#*=}"
            ;;
    esac
    shift
done

# #
#   check if %FETCH (apt-move) available
# #

if [ ! -f $FETCH ]; then
    echo 'apt-url requires apt-move'
    echo ' Install with: apt-get install apt-move'
    exit 2
fi

# #
#   check if package provided as param #1
# #

if [ -z "${argPackage}" ]; then
    echo 'Usage:'
    echo '  ' $app_file_bin '<package>'
    exit 1
fi

# #
#   clean cache
# #

sudo apt-get clean

# #
#   get url of package
# #

if [ "${argBoolUseApt}" = true ]; then
    url_exitcode="0"
    url="$(apt-get download --print-uris ${argPackage} "$@" 2>&1)" || { url_exitcode="$?" ; true; };

    IFS=' ' read -r url filename <<< "$url"
    url=(${url[@]//\'/})
    filename=(${filename[@]//\'/})
else
    url_exitcode="0"
    url="$( sudo $FETCH -t ${argPackage} 2>&1)" || { url_exitcode="$?" ; true; };
fi

# #
#   output
# #

if echo "$url" | grep --quiet --ignore-case "Couldn't find package" ; then
    if [ "${argBoolPretty}" = true ]; then
        echo -e
        echo -e "💡 Could not find package ${c[yellow]}${argPackage}${c[end]}"
        echo -e
    else
        echo -e "Could not find package ${argPackage}"
    fi
else
    url=$( echo "$url" | tail -n 1)

    # #
    #   filter URL-encode with ASCII Value
    # #

    url=${url//%23/\#}
    url=${url//%2b/\+}
    url=${url//%2d/\-}
    url=${url//%3a/\:}
    url=${url//%7e/\~}
    url=${url//%7b/\{}
    url=${url//%7d/\}}

    # #
    #   strip filename from url
    # #

    filename="${url##*/}"

    # #
    #   return filename and url
    #   
    #   usage:
    #       query=$( sudo ./apt-url "$pkg_arch" )
    #       app_filename=$( echo "$query" | head -n 1; )
    #       app_url=$( echo "$query" | tail -n 1; )
    # #

    if [ "${argBoolPretty}" = true ]; then
        echo -e
        if [ "${argBoolUrlOnly}" = false ]; then
            printf '%-13s %-29s %-65s\n' " " "  ${c[grey2]}File${c[end]}" "${c[green]}${filename}${c[end]}"
        fi
        if [ "${argBoolFileOnly}" = false ]; then
            printf '%-13s %-29s %-65s\n' " " "  ${c[grey2]}URL${c[end]}" "${c[green]}${url}${c[end]}"
        fi
        echo -e
    else
        if [ "${argBoolUrlOnly}" = false ]; then
            echo $filename
        fi
        if [ "${argBoolFileOnly}" = false ]; then
            echo $url
        fi
    fi
fi